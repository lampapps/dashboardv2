[Unit]
Description=JABS dashboard (@NAME@) web UI and agent API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/python -m app web
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@APP_DIR@/data

[Install]
WantedBy=multi-user.target
